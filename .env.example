# Opcion 1: cadena completa
DATABASE_URL=postgresql://postgres:TU_CLAVE_AQUI@localhost:5432/mercaapp

# Opcion 2: variables separadas
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=TU_CLAVE_AQUI
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mercaapp

# Chatbot provider
CHATBOT_PROVIDER=ollama

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Cuando generes tu modelo propio, puedes cambiarlo por algo como:
# OLLAMA_MODEL=mercaapp-agent

# Alternativa OpenAI
# OPENAI_API_KEY=tu_api_key_aqui
# OPENAI_CHAT_MODEL=gpt-5.1
